    "TBB could not complete the operation. Check file access and available storage.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TBB no pudo completar la operación. Revisa el acceso al archivo y el espacio disponible."
          }
        }
      }
    },
    "The backup exceeds the supported size.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El respaldo supera el tamaño permitido."
          }
        }
      }
    },
    "The backup format or budget data is invalid.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato del respaldo o los datos del presupuesto no son válidos."
          }
        }
      }
    },
    "This backup version requires a different version of TBB.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este respaldo requiere otra versión de TBB."
          }
        }
      }
    },
    "This export includes household data. Anyone with a readable copy can keep it after sharing ends.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este respaldo incluye datos del hogar. Quien tenga una copia legible podrá conservarla aunque dejes de compartir el presupuesto."
          }
        }
      }
    },
    "This file is unencrypted and unauthenticated. Only restore it if you trust its source.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo está sin cifrar y su autenticidad no está verificada. Restáuralo solo si confías en su origen."
          }
        }
      }
    },
